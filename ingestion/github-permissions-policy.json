{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Resource":  "*",
                          "Action":  [
                                         "ecr:GetAuthorizationToken"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Resource":  "arn:aws:ecr:eu-north-1:411145869013:repository/population-ingestion",
                          "Action":  [
                                         "ecr:BatchCheckLayerAvailability",
                                         "ecr:InitiateLayerUpload",
                                         "ecr:UploadLayerPart",
                                         "ecr:CompleteLayerUpload",
                                         "ecr:PutImage",
                                         "ecr:BatchGetImage"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Resource":  "arn:aws:lambda:eu-north-1:411145869013:function:population-ingestion-dev",
                          "Action":  [
                                         "lambda:UpdateFunctionCode",
                                         "lambda:GetFunctionConfiguration",
                                         "lambda:GetFunction"
                                     ]
                      }
                  ]
}
